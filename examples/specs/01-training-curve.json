{
  "kind": "line",
  "title": "Test accuracy over training",
  "x": {
    "field": "epoch",
    "label": "Training epoch"
  },
  "y": {
    "field": "accuracy",
    "label": "Test accuracy",
    "unit": "%"
  },
  "group": "model",
  "aggregation": "mean",
  "series_order": [
    "baseline",
    "+augment",
    "+distill",
    "ours"
  ],
  "emphasis": {
    "series": "ours"
  },
  "legend": {
    "position": "outside_right"
  },
  "data": {
    "path": "data/training.csv",
    "columns": [
      "model",
      "seed",
      "epoch",
      "accuracy",
      "loss"
    ]
  },
  "output": {
    "stem": "01-training-curve"
  }
}

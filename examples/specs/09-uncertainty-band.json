  },
  "reference_lines": [
    {
      "axis": "y",
      "value": 25,
      "meaning": "chance",
      "label": "chance"
    }
  ],
  "annotate": [
    {
      "at": "max",
      "series": "ours",
      "text": "best"
    }
  ],
  "legend": {
    "position": "outside_right"
  },
  "data": {
    "path": "data/training.csv",
    "columns": [
      "model",
      "seed",
      "epoch",
      "accuracy",
      "loss"
    ]
  },
  "output": {
    "stem": "09-uncertainty-band",
    "size": "double_column"

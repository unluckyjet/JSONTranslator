{
  "kind": "line",
  "title": "Accuracy over training, mean of three seeds",
  "x": {
    "field": "epoch",
    "label": "Training epoch"
  },
  "y": {
    "field": "accuracy",
    "label": "Test accuracy",
    "unit": "%"
  },
  "group": "model",
  "aggregation": "mean",
  "uncertainty": {
    "kind": "ci",
    "level": 0.95,
    "over": "seed",
    "display": "band"
  },
  "series_order": [

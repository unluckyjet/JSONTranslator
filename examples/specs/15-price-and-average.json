{
  "kind": "line",
  "title": "The average follows the price, it does not predict it",
  "x": {
    "field": "date",
    "label": "Date",
    "temporal": true
  },
  "y": {
    "field": "close",
    "label": "Closing price",
    "unit": "$"
  },
  "aggregation": "mean",
  "smooth": {
    "kind": "rolling",
    "window": 20,
    "show_raw": true
  },
  "annotate": [
    { "at": "max", "text": "peak" },
    { "at": "min", "text": "trough, down 38%" }
  ],
  "legend": {
    "show": false
  },
  "data": {
    "path": "data/prices.csv",
    "columns": ["date", "close", "volume"]
  },
  "output": {
    "stem": "15-price-and-average",
    "size": "double_column"
  },
  "caption": "Simulated daily closing price for one trading year, with a 20-day rolling average.",
  "alt_text": "Simulated data. No real company is depicted."
}

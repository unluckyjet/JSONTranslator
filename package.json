{
  "name": "graph-unslopify",
  "version": "0.6.0",
  "description": "MCP server that turns a semantic figure spec into runnable matplotlib code.",
  "scripts": {
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev": "vercel dev",
    "deploy": "vercel deploy --prod",
    "smoke": "node --experimental-strip-types scripts/smoke.ts",
    "render-check": "node --experimental-strip-types scripts/render-check.ts",
    "baseline": "node --experimental-strip-types scripts/baseline.ts",
    "example-data": "node --experimental-strip-types scripts/make-example-data.ts",
    "test:python": "python3 -m pytest python/tests -q",
    "recipe-check": "node --experimental-strip-types scripts/recipe-check.ts",
    "compose-check": "node --experimental-strip-types scripts/compose-check.ts"
  },
  "type": "module",
  "dependencies": {
    "mcp-handler": "^2.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.6"
  }
}

{
  "name": "graph-unslopify",
  "version": "0.4.0",
  "description": "MCP server that turns a semantic figure spec into runnable matplotlib code.",
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "dev": "vercel dev",
    "deploy": "vercel deploy --prod",
    "smoke": "node scripts/smoke.ts",
    "render-check": "node scripts/render-check.ts",
    "baseline": "node scripts/baseline.ts",
    "example-data": "node scripts/make-example-data.ts",
    "test:python": "python -m pytest python/tests -q",
    "recipe-check": "node scripts/recipe-check.ts"
  },
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "mcp-handler": "^2.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
